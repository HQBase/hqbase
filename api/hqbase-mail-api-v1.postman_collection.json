  "item": [
    {
      "name": "OAuth setup",
      "item": [
        {
          "name": "Authorization server metadata",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/.well-known/oauth-authorization-server/api/auth"
            }
          },
          "response": []
        },
        {
          "name": "Mail API protected-resource metadata",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/.well-known/oauth-protected-resource/api/v1"
            }
          },
          "response": []
        },
        {
          "name": "Register public client",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const registration = pm.response.json();",
                  "if (registration.client_id) pm.environment.set('client_id', registration.client_id);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"client_name\": \"HQBase Postman\",\n  \"redirect_uris\": [\n    \"https://oauth.pstmn.io/v1/browser-callback\"\n  ],\n  \"token_endpoint_auth_method\": \"none\",\n  \"grant_types\": [\n    \"authorization_code\",\n    \"refresh_token\"\n  ],\n  \"response_types\": [\n    \"code\"\n  ],\n  \"scope\": \"mail:read mail:write mail:send offline_access\",\n  \"resources\": [\n    \"{{api_resource}}\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/auth/oauth2/register"
            },
            "description": "Creates a public PKCE client. The test script stores client_id in the active local environment."
          },
          "response": []
        }
      ]
    },
