{
  "name": "hqbase",
  "version": "1.3.4",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "hqbaseRelease": {
    "minimumVersion": "1.0.0",
    "updaterCommit": "7d67e4ae54fe4deafba41c0b5daab5a34cdfe4f9",
    "updaterCommitVersion": "1.3.4"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:vite": "vite --host 127.0.0.1 --port 5173",
    "dev:ui": "vite --host 127.0.0.1 --port 5173 --open /__ui/design",
    "dev:setup-ui": "vite --host 127.0.0.1 --port 5173 --open /__ui/setup?state=loading",
    "build": "node scripts/release/prepare-worker-config.mjs && vite build && node scripts/build-pwa.mjs && node scripts/check-setup-preview-boundary.mjs",
    "deploy": "node scripts/release/deploy.mjs",
    "db:reset:local": "wrangler d1 execute DB --local --yes --file scripts/hqbase/reset-d1.sql && node scripts/d1-migrations.mjs --local",
    "db:migrate:local": "node scripts/d1-migrations.mjs --local",
    "db:seed:local": "node scripts/seed-local.mjs",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "code:check": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.worker.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "test:architecture": "node scripts/check-architecture.mjs",
    "api:generate": "node scripts/generate-mail-api-artifacts.mjs --write && biome format --write api/hqbase-mail-api-v1.openapi.json api/hqbase-mail-api-v1.postman_collection.json api/hqbase-mail-api-v1.postman_environment.json api/hqbase-mail-api-v2.openapi.json api/hqbase-mail-api-v2.postman_collection.json api/hqbase-mail-api-v2.postman_environment.json",
    "api:check": "node scripts/generate-mail-api-artifacts.mjs --check",
    "test:pwa": "node scripts/test-pwa.mjs",
    "test:e2e:staging": "playwright test --config playwright.config.ts app-shell-smoke.spec.ts event-socket.spec.ts lifecycle.spec.ts",
    "test:e2e:staging:event-socket": "playwright test --config playwright.config.ts event-socket.spec.ts",
    "test:e2e:staging:smoke": "playwright test --config playwright.config.ts app-shell-smoke.spec.ts",
    "test:e2e:staging:lifecycle": "playwright test --config playwright.config.ts lifecycle.spec.ts",
    "pwa:icons": "node scripts/generate-pwa-icons.mjs",
    "check": "pnpm code:check && pnpm typecheck && pnpm api:check && pnpm test && pnpm test:coverage && pnpm test:architecture && pnpm build",
    "deploy:dry-run": "pnpm build && wrangler deploy --dry-run",
    "hqbase": "node scripts/hqbase/cli.mjs",
    "hqbase:button": "node scripts/hqbase/cli.mjs button",
    "hqbase:install": "node scripts/hqbase/cli.mjs install",
    "hqbase:doctor": "node scripts/hqbase/cli.mjs doctor",
    "hqbase:reset": "node scripts/hqbase/cli.mjs reset",
    "hqbase:destroy": "node scripts/hqbase/cli.mjs destroy",
    "cf:typegen": "wrangler types",
    "release:package": "node scripts/release/package.mjs"
  },
  "cloudflare": {
    "bindings": {
      "DB": {
        "description": "Create a new D1 database for this HQBase workspace."
      },
      "MAIL_OBJECTS": {
        "description": "Create a new R2 bucket for this HQBase workspace."
      },
      "MAIL_EVENTS": {
        "description": "Hibernating Durable Object used for access-scoped mail synchronization wake-ups."
      },
      "HQBASE_JOBS": {
        "description": "Queue used for bounded maintenance and integrity jobs with a dead-letter queue."
      },
      "MAIL_SENDER": {
        "description": "Cloudflare Email Sending binding. The sending domain must be onboarded in Cloudflare Email Service."
      },
      "ASSETS": {
        "description": "Worker Static Assets binding serving the Vite build output from `dist`."
      }
    }
  },
  "dependencies": {
    "@better-auth/oauth-provider": "1.7.0-rc.6",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.7",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.11",
    "@radix-ui/react-progress": "^1.1.12",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@tiptap/extension-image": "3.27.3",
    "@tiptap/extension-placeholder": "^3.27.3",
    "@tiptap/react": "^3.27.3",
    "@tiptap/starter-kit": "^3.27.3",
    "better-auth": "1.7.0-rc.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "domhandler": "^6.0.1",
    "drizzle-orm": "0.45.2",
    "hono": "^4.13.2",
    "htmlparser2": "^12.0.0",
    "postal-mime": "^2.5.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-icons": "^5.7.0",
    "sanitize-html": "^2.17.6",
    "sonner": "^2.0.6",
    "tailwind-merge": "^3.3.1",
    "web-push": "^3.6.7",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@cloudflare/vitest-pool-workers": "0.18.8",
    "@playwright/test": "1.61.1",
    "@types/node": "^26.0.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/sanitize-html": "^2.16.1",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitest/coverage-v8": "4.1.10",
    "autoprefixer": "^10.4.21",
    "cross-spawn": "7.0.6",
    "happy-dom": "20.10.6",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vite": "^7.0.5",
    "vitest": "^4.1.10",
    "wrangler": "^4.114.0"
  }
}
