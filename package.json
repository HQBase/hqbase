{
  "name": "hqbase-pro",
  "version": "0.1.11",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "hqbaseRelease": {
    "minimumVersion": "0.1.3"
  },
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "dev:vite": "vite --host 127.0.0.1 --port 5173",
    "dev:setup-ui": "vite --host 127.0.0.1 --port 5173 --open /__ui/setup?state=loading",
    "build": "vite build && node scripts/build-pwa.mjs && node scripts/check-setup-preview-boundary.mjs",
    "deploy": "pnpm build && node scripts/hqbase-pro/deploy.mjs && pnpm hqbase-pro postdeploy",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "code:check": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.worker.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "test:architecture": "node scripts/check-architecture.mjs",
    "test:pwa": "node scripts/test-pwa.mjs",
    "test:e2e:staging": "playwright test --config playwright.config.ts",
    "check": "pnpm code:check && pnpm typecheck && pnpm test && pnpm test:coverage && pnpm test:architecture && pnpm build",
    "deploy:dry-run": "pnpm build && wrangler deploy --dry-run",
    "hqbase-pro": "node scripts/hqbase-pro/cli.mjs",
    "hqbase-pro:button": "node scripts/hqbase-pro/cli.mjs button",
    "hqbase-pro:install": "node scripts/hqbase-pro/cli.mjs install",
    "hqbase-pro:doctor": "node scripts/hqbase-pro/cli.mjs doctor",
    "hqbase-pro:reset": "node scripts/hqbase-pro/cli.mjs reset",
    "hqbase-pro:destroy": "node scripts/hqbase-pro/cli.mjs destroy",
    "hqbase-pro:upgrade": "node scripts/hqbase-pro/upgrade.mjs",
    "cf:typegen": "wrangler types",
    "release:package": "node scripts/release/package.mjs"
  },
  "cloudflare": {
    "bindings": {
      "BETTER_AUTH_SECRET": {
        "description": "Required Better Auth signing secret. Paste a long random value generated with `openssl rand -base64 32`."
      },
      "PRO_APP_PASSWORD_PEPPER": {
        "description": "Secret HMAC pepper for mail-client app passwords. Generated per deployment."
      },
      "PRO_BRIDGE_TOKEN": {
        "description": "Deployment-scoped bearer token shared only with the mail bridge."
      },
      "PRO_SESSION_SECRET": {
        "description": "Secret HMAC key for short-lived mail-bridge sessions."
      },
      "PRO_ENTITLEMENT_SECRET": {
        "description": "Deployment-scoped AES key material used to encrypt the Polar license key stored in D1."
      },
      "DB": {
        "description": "Create a new D1 database for a fresh Pro workspace. Community upgrades preserve and detect their existing database automatically."
      },
      "MAIL_OBJECTS": {
        "description": "Create a new R2 bucket for a fresh Pro workspace. Community upgrades preserve and detect their existing mail bucket automatically."
      },
      "PRO_JOBS": {
        "description": "Queue used for bounded Pro maintenance and integrity jobs with a dead-letter queue."
      },
      "MAIL_SENDER": {
        "description": "Cloudflare Email Sending binding. The sending domain must be onboarded in Cloudflare Email Service."
      },
      "ASSETS": {
        "description": "Worker Static Assets binding serving the Vite build output from `dist`."
      }
    }
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.16",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.7",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.11",
    "@radix-ui/react-progress": "^1.1.12",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@tiptap/extension-link": "^3.27.3",
    "@tiptap/extension-placeholder": "^3.27.3",
    "@tiptap/react": "^3.27.3",
    "@tiptap/starter-kit": "^3.27.3",
    "better-auth": "^1.3.15",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.8.5",
    "lucide-react": "^0.525.0",
    "postal-mime": "^2.5.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sanitize-html": "^2.17.6",
    "sonner": "^2.0.6",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@cloudflare/vitest-pool-workers": "0.18.4",
    "@playwright/test": "1.61.1",
    "@types/node": "^26.0.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/sanitize-html": "^2.16.1",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitest/coverage-v8": "4.1.10",
    "autoprefixer": "^10.4.21",
    "blake3-wasm": "2.1.5",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vite": "^7.0.5",
    "vitest": "^4.1.10",
    "wrangler": "^4.110.0"
  }
}
